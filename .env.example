# ISG Pro Docker Compose Environment Variables Template
# Copy this file to .env and update with real values

# PostgreSQL superuser - used only to bootstrap the cluster and run init-db.sh.
# The application does NOT use this account.
POSTGRES_PASSWORD=my_superuser_password
POSTGRES_DB=isg_db
# Application database user - created by init-db.sh and used by ISG nodes
# (via pgbouncer) for all runtime queries.
ISG_DB_USER=isg
ISG_DB_PASSWORD=my_app_password

# Define bind address and port for PgBouncer (using 0.0.0.0 will bind to all interfaces!)
PGBOUNCER_HOST=0.0.0.0
PGBOUNCER_PORT=6432

# Set arguments below when using docker-compose.yml file:
# NAS Storage Mount Path (update this to your actual NAS mount point)
NAS_STORAGE_PATH=/path/to/your/nas/mount
# iconik Configuration
ICONIK_APP_ID=
ICONIK_AUTH_TOKEN=
ICONIK_URL=https://app.iconik.io/
# create an ISG cluster at https://app.iconik.io/admin/isg/
# and use its main node id as the value for ICONIK_STORAGE_GATEWAY_ID
ICONIK_STORAGE_GATEWAY_ID=
